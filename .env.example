APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true
# Session cookie Secure flag. Leave this UNSET and it derives from APP_ENV
# automatically: true in production, false otherwise. Set it explicitly only to
# override, e.g. it must be true in production, and may be set to false only for
# local HTTP development. Prefer leaving it unset so it cannot be carried into
# production incorrectly.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- n8n Evidence Analysis (Optional - requires Docker) ---
# Enable only when n8n is running: docker compose up -d
N8N_ENABLED=false
N8N_API_KEY="n8nComplianceHubSecretKey"
N8N_UNIFIED_WEBHOOK_URL="http://host.docker.internal:5678/webhook/evidence-processing"
N8N_CHAT_MESSAGE_WEBHOOK_URL="http://host.docker.internal:5678/webhook/chat-message"
N8N_HITL_WEBHOOK_URL="http://host.docker.internal:5678/webhook/hitl-review"
N8N_WEBHOOK_SECRET="your-n8n-webhook-secret"

# n8n SMTP host for internal Docker communication (used by n8n:setup command)
N8N_SMTP_HOST=host.docker.internal

# AI Provider (Ollama local by default)
AI_PROVIDER=ollama

# Ollama (local AI — recommended for data privacy)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llava:7b
OLLAMA_TIMEOUT=300

# ClamAV REST API (from host)
CLAMAV_API_URL="http://localhost:9000"

# Laravel internal URL (as seen from n8n inside Docker)
APP_INTERNAL_URL="http://host.docker.internal:8000"

# Load-test auth bypass (OFF by default — k6 scripts depend on this)
# Set to true only during load testing to skip OTP via /auto-login.
LOAD_TEST_BYPASS_ENABLED=false
